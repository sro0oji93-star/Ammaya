<%- include('partials/header') %>

<div class="mad-breadcrumb with-bg-image" data-bg-image-src="/images/revolution/6cbea-bg1.jpg">
  <div class="container">
    <h1 class="mad-page-title" style="color:#fff">Unsere Speisekarte</h1>
    <nav class="mad-breadcrumb-path"><span><a href="/">Home</a></span> / <span>Unsere Speisekarte</span></nav>
  </div>
</div>

<div class="mad-content no-pd">
  <% var productImgMap = {
    'margherita':'/images/products/img1.jpg','salami':'/images/products/img2.jpg','prosciutto':'/images/products/img3.jpg',
    'classic-burger':'/images/products/img13.jpg','cheese-burger':'/images/products/img14.jpg','chicken-burger':'/images/products/img15.jpg',
    'croque-monsieur':'/images/products/img7.jpg','croque-madame':'/images/products/img8.jpg','croque-hawaii':'/images/products/img9.jpg',
    'griechischer-salat':'/images/products/img4.jpg','caesar-salat':'/images/products/img5.jpg',
    'spaghetti-bolognese':'/images/products/img10.jpg','penne-arrabiata':'/images/products/img11.jpg',
    'wiener-schnitzel':'/images/products/img16.jpg','jaegerschnitzel':'/images/products/img17.jpg','zigeunerschnitzel':'/images/products/img18.jpg',
    'pommes-frites':'/images/products/img19.jpg','chicken-nuggets':'/images/products/img20.jpg','nachos':'/images/products/img21.jpg',
    'coca-cola':'/images/products/img22.jpg','fanta':'/images/products/img23.jpg','wasser':'/images/products/img6.jpg',
    'fruehlingsrolle':'/images/products/img7.jpg','falafel-wrap':'/images/products/img8.jpg',
    'ketchup':'/images/products/img9.jpg','mayonnaise':'/images/products/img12.jpg','knoblauchsauce':'/images/products/img3.jpg','chillisauce':'/images/products/img4.jpg'
  }; %>
  <% categories.forEach(function(cat, ci) { %>
  <% var catProducts = products.filter(function(p) { return p.category_id === cat.id; }); %>
  <div class="mad-section">
    <div class="container">
      <h2 class="mad-page-title align-center"><%= cat.name %></h2>
      <div class="content-element-7">
        <% if (catProducts.length === 0) { %>
        <p class="align-center" style="color:#7a7879;font-size:1.1rem;padding:20px 0">Bald verfügbar</p>
        <% } else { %>
        <div class="row">
          <% var half = Math.ceil(catProducts.length / 2); %>
          <div class="col-lg-6">
            <% catProducts.slice(0, half).forEach(function(p) { %>
            <div class="mad-spec-item" style="display:flex;margin-bottom:2rem">
              <figure style="max-width:88px;min-width:88px;width:100%;margin-right:1.5rem;border-radius:50%;overflow:hidden;height:88px;background:#f8f5f0;display:flex;align-items:center;justify-content:center">
                <img src="<%= p.image || productImgMap[p.slug] || '/images/products/img1.jpg' %>" alt="<%= p.name %>" style="width:100%;height:100%;object-fit:cover">
              </figure>
              <div class="mad-spec-info" style="flex:1">
                <div class="mad-spec-header" style="display:flex;font-family:'Josefin Sans',sans-serif;font-weight:bold;font-size:1.5rem;line-height:2rem;color:#232223;justify-content:space-between;margin:0 -1.5rem">
                  <div class="mad-spec-title" style="padding:0 1.5rem"><%= p.name %></div>
                  <div class="mad-line" style="flex:1;border-bottom:2px dotted #7a7879;height:1.4rem;margin:0 0.25rem"></div>
                  <% if (p.sizes) { var sz = JSON.parse(p.sizes); var minP = Math.min.apply(null, sz.map(function(s){return s.price})); %>
                  <div class="mad-spec-price" style="padding:0 1.5rem;color:#eb0029;white-space:nowrap">ab <%= minP.toFixed(2) %> €</div>
                  <% } else { %>
                  <div class="mad-spec-price" style="padding:0 1.5rem;color:#eb0029;white-space:nowrap"><%= p.price.toFixed(2) %> €</div>
                  <% } %>
                </div>
                <div class="mad-spec-tags" style="font-size:1rem;line-height:1.5rem;color:#7a7879;margin-top:0.25rem">
                  <div class="mad-spec-el"><%= p.description %></div>
                </div>
                <% if (p.sizes) { var sizeData = JSON.parse(p.sizes); %>
                <div class="size-picker" style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px">
                  <% sizeData.forEach(function(s) { %>
                  <label class="size-option" style="cursor:pointer;padding:6px 14px;border:2px solid #e0e0e0;border-radius:10px;font-size:13px;transition:all .25s ease;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,0.04);text-align:center">
                    <input type="radio" name="size_<%= p.id %>" value="<%= s.price %>" data-label="<%= s.label %>" data-id="<%= p.id %>" data-name="<%= p.name %>" style="display:none" <%= sizeData.indexOf(s) === 0 ? 'checked' : '' %>>
                    <span style="display:block;font-weight:600;font-size:13px"><%= s.label %></span>
                    <span style="display:block;color:#eb0029;font-weight:700;font-size:12px"><%= s.price.toFixed(2) %>€</span>
                  </label>
                  <% }); %>
                </div>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1" style="margin-top:10px">In den Warenkorb</button>
                <% } else { %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" style="margin-top:8px">In den Warenkorb</button>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
          <div class="col-lg-6">
            <% catProducts.slice(half).forEach(function(p) { %>
            <div class="mad-spec-item" style="display:flex;margin-bottom:2rem">
              <figure style="max-width:88px;min-width:88px;width:100%;margin-right:1.5rem;border-radius:50%;overflow:hidden;height:88px;background:#f8f5f0;display:flex;align-items:center;justify-content:center">
                <img src="<%= p.image || productImgMap[p.slug] || '/images/products/img1.jpg' %>" alt="<%= p.name %>" style="width:100%;height:100%;object-fit:cover">
              </figure>
              <div class="mad-spec-info" style="flex:1">
                <div class="mad-spec-header" style="display:flex;font-family:'Josefin Sans',sans-serif;font-weight:bold;font-size:1.5rem;line-height:2rem;color:#232223;justify-content:space-between;margin:0 -1.5rem">
                  <div class="mad-spec-title" style="padding:0 1.5rem"><%= p.name %></div>
                  <div class="mad-line" style="flex:1;border-bottom:2px dotted #7a7879;height:1.4rem;margin:0 0.25rem"></div>
                  <% if (p.sizes) { var sz = JSON.parse(p.sizes); var minP = Math.min.apply(null, sz.map(function(s){return s.price})); %>
                  <div class="mad-spec-price" style="padding:0 1.5rem;color:#eb0029;white-space:nowrap">ab <%= minP.toFixed(2) %> €</div>
                  <% } else { %>
                  <div class="mad-spec-price" style="padding:0 1.5rem;color:#eb0029;white-space:nowrap"><%= p.price.toFixed(2) %> €</div>
                  <% } %>
                </div>
                <div class="mad-spec-tags" style="font-size:1rem;line-height:1.5rem;color:#7a7879;margin-top:0.25rem">
                  <div class="mad-spec-el"><%= p.description %></div>
                </div>
                <% if (p.sizes) { var sizeData = JSON.parse(p.sizes); %>
                <div class="size-picker" style="margin-top:10px;display:flex;flex-wrap:wrap;gap:6px">
                  <% sizeData.forEach(function(s) { %>
                  <label class="size-option" style="cursor:pointer;padding:6px 14px;border:2px solid #e0e0e0;border-radius:10px;font-size:13px;transition:all .25s ease;background:#fff;box-shadow:0 1px 4px rgba(0,0,0,0.04);text-align:center">
                    <input type="radio" name="size_<%= p.id %>" value="<%= s.price %>" data-label="<%= s.label %>" data-id="<%= p.id %>" data-name="<%= p.name %>" style="display:none" <%= sizeData.indexOf(s) === 0 ? 'checked' : '' %>>
                    <span style="display:block;font-weight:600;font-size:13px"><%= s.label %></span>
                    <span style="display:block;color:#eb0029;font-weight:700;font-size:12px"><%= s.price.toFixed(2) %>€</span>
                  </label>
                  <% }); %>
                </div>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1" style="margin-top:8px">In den Warenkorb</button>
                <% } else { %>
                <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>" style="margin-top:8px">In den Warenkorb</button>
                <% } %>
              </div>
            </div>
            <% }); %>
          </div>
        <% } %>
      </div>
      <div class="align-center">
        <a href="/speisekarte" class="btn btn-style-3 btn-big">Alle ansehen</a>
      </div>
    </div>
  </div>
  <% }); %>
</div>

<script>
document.querySelectorAll('.size-picker').forEach(function(picker) {
  var first = picker.querySelector('input[type="radio"]');
  if (first) {
    var label = first.closest('.size-option');
    if (label) { label.style.borderColor = '#eb0029'; label.style.background = '#fff5f5'; label.style.boxShadow = '0 0 0 3px rgba(235,0,41,0.15)'; }
  }
  picker.querySelectorAll('input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      picker.querySelectorAll('.size-option').forEach(function(l) {
        l.style.borderColor = '#e0e0e0';
        l.style.background = '#fff';
        l.style.boxShadow = '0 1px 4px rgba(0,0,0,0.04)';
      });
      var label = this.closest('.size-option');
      if (label) { label.style.borderColor = '#eb0029'; label.style.background = '#fff5f5'; label.style.boxShadow = '0 0 0 3px rgba(235,0,41,0.15)'; }
    });
  });
  // Hover effect
  picker.querySelectorAll('.size-option').forEach(function(l) {
    l.addEventListener('mouseenter', function() {
      if (this.style.borderColor !== 'rgb(235, 0, 41)') { this.style.borderColor = '#ccc'; }
    });
    l.addEventListener('mouseleave', function() {
      if (this.style.borderColor !== 'rgb(235, 0, 41)') { this.style.borderColor = '#e0e0e0'; }
    });
  });
});
</script>
<%- include('partials/footer') %>