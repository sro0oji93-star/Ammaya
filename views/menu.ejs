<%- include('partials/header') %>

<div class="page-hero menu-hero" style="background-image:url('https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=1600&q=80');background-size:cover;background-position:center;position:relative">
  <div class="page-hero-overlay" style="position:absolute;inset:0;background:rgba(35,34,35,.5);z-index:1"></div>
  <div class="page-hero-content" style="position:relative;z-index:2">
    <div class="page-hero-badge">SPEISEKARTE</div>
    <h1 class="page-hero-title" style="color:#fff">Unsere Speisekarte</h1>
    <nav class="menu-breadcrumb"><a href="/">Start</a> / <span>Speisekarte</span></nav>
  </div>
</div>

<section class="section menu-section">
  <div class="container">
    <div class="menu-filter">
      <button class="filter-btn active" data-filter="all">Alle</button>
      <% categories.forEach(function(c) { %>
      <button class="filter-btn" data-filter="<%= c.slug %>"><%= c.name %></button>
      <% }) %>
    </div>

    <% categories.forEach(function(cat) { %>
    <div class="menu-category" data-category="<%= cat.slug %>">
      <div class="menu-category-head">
        <h2 class="menu-category-title"><%= cat.name %></h2>
        <% if (cat.description) { %><p class="menu-category-desc"><%= cat.description %></p><% } %>
      </div>
      <div class="menu-specs">
        <% var catProducts = products.filter(function(p) { return p.category_id === cat.id; }); %>
        <% catProducts.forEach(function(p) { %>
        <div class="menu-spec-item">
          <div class="menu-spec-img">
            <i class="fas fa-<%= p.category_id == 8 ? 'wine-glass-alt' : (p.category_id == 4 ? 'leaf' : (p.category_id == 10 ? 'tint' : 'utensils')) %>"></i>
          </div>
          <div class="menu-spec-info">
            <div class="menu-spec-header">
              <h3 class="menu-spec-title"><%= p.name %></h3>
              <span class="menu-spec-line"></span>
              <span class="menu-spec-price"><%= p.price.toFixed(2) %> €</span>
            </div>
            <p class="menu-spec-desc"><%= p.description %></p>
            <div class="menu-spec-actions">
              <button class="btn btn-primary btn-sm add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">
                <i class="fas fa-shopping-bag"></i> In den Warenkorb
              </button>
            </div>
          </div>
        </div>
        <% }); %>
        <% if (catProducts.length === 0) { %>
        <p class="menu-empty">In dieser Kategorie sind derzeit keine Gerichte verfügbar.</p>
        <% } %>
      </div>
    </div>
    <% }); %>
  </div>
</section>

<%- include('partials/footer') %>