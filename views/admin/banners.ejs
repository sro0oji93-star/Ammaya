<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-images"></i> Banner verwalten</h2>
  <button class="btn btn-primary" onclick="openModal('addBannerModal')"><i class="fas fa-plus"></i> Neues Banner</button>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Bild</th>
        <th>Titel</th>
        <th>Untertitel</th>
        <th>Link</th>
        <th>Sortierung</th>
        <th>Status</th>
        <th>Aktion</th>
      </tr>
    </thead>
    <tbody>
      <% banners.forEach(function(b) { %>
      <tr>
        <td>
          <div class="product-thumb" style="<%= b.image ? 'background-image: url(' + b.image + ')' : 'background: linear-gradient(135deg, #1a1a2e, #2a1a3e)' %>">
            <% if (!b.image) { %><i class="fas fa-image"></i><% } %>
          </div>
        </td>
        <td><strong><%= b.title %></strong></td>
        <td><%= b.subtitle || '—' %></td>
        <td><%= b.link ? '<a href="' + b.link + '" target="_blank">Link</a>' : '—' %></td>
        <td><%= b.sort_order %></td>
        <td><span class="status-badge <%= b.active ? 'status-verfuegbar' : 'status-ausverkauft' %>"><%= b.active ? 'Aktiv' : 'Inaktiv' %></span></td>
        <td>
          <form method="POST" action="/admin/banner/loeschen/<%= b.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')">
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="modal" id="addBannerModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Neues Banner</h3>
      <button class="modal-close" onclick="closeModal('addBannerModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/banner" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="form-group">
          <label>Titel *</label>
          <input type="text" name="title" required>
        </div>
        <div class="form-group">
          <label>Untertitel</label>
          <input type="text" name="subtitle">
        </div>
        <div class="form-group">
          <label>Link-URL</label>
          <input type="url" name="link" placeholder="https://...">
        </div>
        <div class="form-group">
          <label>Bild</label>
          <input type="file" name="image" accept="image/*">
        </div>
        <div class="form-group">
          <label>Sortierung</label>
          <input type="number" name="sort_order" value="0">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>
</div>
<%- include('footer') %>
