<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-pizza-slice"></i> Pizza-Größen verwalten</h2>
</div>

<div style="background:#fff;border-radius:12px;padding:24px;box-shadow:0 2px 12px rgba(0,0,0,0.06);margin-bottom:20px">
  <h3 style="margin:0 0 16px 0;font-size:18px">Größen für alle Pizzen festlegen</h3>
  <form method="POST" action="/admin/produkte/pizza-groesen" id="sizesForm">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div id="sizeRows">
      <div class="size-row" style="display:flex;gap:10px;margin-bottom:10px;align-items:center">
        <input type="text" name="size_label[]" placeholder="z.B. 26cm" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="26cm">
        <input type="number" step="0.01" name="size_price[]" placeholder="Preis" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="8.00">
        <button type="button" onclick="this.parentElement.remove()" style="padding:8px 14px;border:none;border-radius:8px;background:#e74c3c;color:#fff;cursor:pointer;font-size:16px">&times;</button>
      </div>
      <div class="size-row" style="display:flex;gap:10px;margin-bottom:10px;align-items:center">
        <input type="text" name="size_label[]" placeholder="z.B. 30cm" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="30cm">
        <input type="number" step="0.01" name="size_price[]" placeholder="Preis" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="11.00">
        <button type="button" onclick="this.parentElement.remove()" style="padding:8px 14px;border:none;border-radius:8px;background:#e74c3c;color:#fff;cursor:pointer;font-size:16px">&times;</button>
      </div>
      <div class="size-row" style="display:flex;gap:10px;margin-bottom:10px;align-items:center">
        <input type="text" name="size_label[]" placeholder="z.B. 45*32" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="45*32">
        <input type="number" step="0.01" name="size_price[]" placeholder="Preis" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="17.00">
        <button type="button" onclick="this.parentElement.remove()" style="padding:8px 14px;border:none;border-radius:8px;background:#e74c3c;color:#fff;cursor:pointer;font-size:16px">&times;</button>
      </div>
      <div class="size-row" style="display:flex;gap:10px;margin-bottom:10px;align-items:center">
        <input type="text" name="size_label[]" placeholder="z.B. 40*60" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="40*60">
        <input type="number" step="0.01" name="size_price[]" placeholder="Preis" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px" value="24.50">
        <button type="button" onclick="this.parentElement.remove()" style="padding:8px 14px;border:none;border-radius:8px;background:#e74c3c;color:#fff;cursor:pointer;font-size:16px">&times;</button>
      </div>
    </div>
    <button type="button" onclick="addRow()" style="padding:8px 18px;border:2px dashed #ccc;border-radius:8px;background:transparent;color:#666;cursor:pointer;font-size:14px;margin:8px 0 16px 0">+ Größe hinzufügen</button>
    <div>
      <button type="submit" class="btn btn-primary" style="padding:12px 32px;font-size:16px">Auf alle Pizzen anwenden</button>
    </div>
  </form>
</div>

<p style="color:#7a7879">Diese Größen werden für ALLE Produkte in der Kategorie "Pizza" übernommen.</p>

<script>
function addRow() {
  var div = document.createElement('div');
  div.className = 'size-row';
  div.style.cssText = 'display:flex;gap:10px;margin-bottom:10px;align-items:center';
  div.innerHTML = '<input type="text" name="size_label[]" placeholder="Größe" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px">' +
    '<input type="number" step="0.01" name="size_price[]" placeholder="Preis" style="flex:1;padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:14px">' +
    '<button type="button" onclick="this.parentElement.remove()" style="padding:8px 14px;border:none;border-radius:8px;background:#e74c3c;color:#fff;cursor:pointer;font-size:16px">&times;</button>';
  document.getElementById('sizeRows').appendChild(div);
}
</script>
<%- include('footer') %>