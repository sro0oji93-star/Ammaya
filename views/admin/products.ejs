<%- include('layout') %>
<% if (duplicate) { %>
<div class="alert alert-warning" style="background:#fff3cd;border:1px solid #ffc107;color:#856404;padding:12px 16px;border-radius:8px;margin-bottom:16px;display:flex;align-items:center;gap:8px">
  <i class="fas fa-exclamation-triangle"></i> Ein Produkt mit diesem Namen existiert bereits.
</div>
<% } %>
<div class="section-header-row">
  <h2><i class="fas fa-utensils"></i> Produkte verwalten</h2>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a href="/admin/produkte/pizza-groesen" class="btn btn-sm btn-outline"><i class="fas fa-pizza-slice"></i> Pizza-Größen</a>
    <button class="btn btn-primary" onclick="openModal('addProductModal')"><i class="fas fa-plus"></i> Neues Produkt</button>
  </div>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Bild</th>
        <th>Name</th>
        <th>Kategorie</th>
        <th>Preis</th>
        <th>Status</th>
        <th>Aktionen</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(p) { %>
      <tr>
        <td>
          <div class="product-thumb" style="background: linear-gradient(135deg, #1a1a2e, #2a1a3e);">
            <i class="fas fa-utensils"></i>
          </div>
        </td>
        <td><strong><%= p.name %></strong></td>
        <td><span class="badge badge-cat"><%= p.category_name || 'Unkategorisiert' %></span></td>
        <td><%= parseFloat(p.price).toFixed(2) %> €</td>
        <td><span class="status-badge <%= p.is_available ? 'status-verfuegbar' : 'status-ausverkauft' %>"><%= p.is_available ? 'Verfügbar' : 'Ausverkauft' %></span></td>
        <td class="actions-cell">
          <button class="btn btn-sm btn-outline" onclick='editProduct(<%= JSON.stringify(p) %>)'><i class="fas fa-edit"></i></button>
          <form method="POST" action="/admin/produkte/loeschen/<%= p.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<!-- Add Modal -->
<div class="modal" id="addProductModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Neues Produkt</h3>
      <button class="modal-close" onclick="closeModal('addProductModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/produkte" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" required>
        </div>
        <div class="form-group">
          <label>Kategorie</label>
          <select name="category_id">
            <option value="">— Keine —</option>
            <% categories.forEach(function(c) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>Preis *</label>
          <input type="number" step="0.01" name="price" required>
        </div>
        <div class="form-group">
          <label>Alter Preis (für Rabatt)</label>
          <input type="number" step="0.01" name="old_price">
        </div>
        <div class="form-group">
          <label>Bild</label>
          <input type="file" name="image" accept="image/*">
        </div>
        <div class="form-group">
          <label>Sortierung</label>
          <input type="number" name="sort_order" value="0">
        </div>
      </div>
      <div class="form-group">
        <label>Beschreibung</label>
        <textarea name="description" rows="2"></textarea>
      </div>
      <div class="form-group">
        <label>Zutaten</label>
        <input type="text" name="ingredients" placeholder="Zutaten, durch Komma getrennt">
      </div>
      <div class="form-group" id="addSizesBuilder">
        <label>Größen</label>
        <div class="sizes-rows"></div>
        <button type="button" class="btn btn-sm btn-outline add-size-btn" onclick="addSizeRow(this, null, null)"><i class="fas fa-plus"></i> Größe hinzufügen</button>
        <input type="hidden" name="sizes" value="">
        <small style="color:var(--text-secondary)">Nur für Produkte mit Größen (z.B. Pizza). Leer lassen für einzelne Preise.</small>
      </div>
      <div class="form-checkboxes">
        <label class="checkbox-label"><input type="checkbox" name="is_featured" value="1"> Empfohlen</label>
        <label class="checkbox-label"><input type="checkbox" name="is_available" value="1" checked> Verfügbar</label>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div class="modal" id="editProductModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Produkt bearbeiten</h3>
      <button class="modal-close" onclick="closeModal('editProductModal')">&times;</button>
    </div>
    <form method="POST" action="" id="editProductForm" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" id="edit_name" required>
        </div>
        <div class="form-group">
          <label>Kategorie</label>
          <select name="category_id" id="edit_category_id">
            <option value="">— Keine —</option>
            <% categories.forEach(function(c) { %>
            <option value="<%= c.id %>"><%= c.name %></option>
            <% }); %>
          </select>
        </div>
        <div class="form-group">
          <label>Preis *</label>
          <input type="number" step="0.01" name="price" id="edit_price" required>
        </div>
        <div class="form-group">
          <label>Alter Preis</label>
          <input type="number" step="0.01" name="old_price" id="edit_old_price">
        </div>
        <div class="form-group">
          <label>Bild</label>
          <input type="file" name="image" accept="image/*">
        </div>
        <div class="form-group">
          <label>Sortierung</label>
          <input type="number" name="sort_order" id="edit_sort_order" value="0">
        </div>
      </div>
      <div class="form-group">
        <label>Beschreibung</label>
        <textarea name="description" id="edit_description" rows="2"></textarea>
      </div>
      <div class="form-group">
        <label>Zutaten</label>
        <input type="text" name="ingredients" id="edit_ingredients">
      </div>
      <div class="form-group" id="editSizesBuilder">
        <label>Größen</label>
        <div class="sizes-rows"></div>
        <button type="button" class="btn btn-sm btn-outline add-size-btn" onclick="addSizeRow(this, null, null)"><i class="fas fa-plus"></i> Größe hinzufügen</button>
        <input type="hidden" name="sizes" id="edit_sizes" value="">
      </div>
      <div class="form-checkboxes">
        <label class="checkbox-label"><input type="checkbox" name="is_featured" id="edit_is_featured" value="1"> Empfohlen</label>
        <label class="checkbox-label"><input type="checkbox" name="is_available" id="edit_is_available" value="1"> Verfügbar</label>
      </div>
      <button type="submit" class="btn btn-primary">Aktualisieren</button>
    </form>
  </div>
</div>
<%- include('footer') %>
