<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-comment"></i> Testimonials verwalten</h2>
  <button class="btn btn-primary" onclick="openModal('addModal')"><i class="fas fa-plus"></i> Neues Testimonial</button>
</div>

<div class="table-container">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Bild</th>
        <th>Name</th>
        <th>Text</th>
        <th>Bewertung</th>
        <th>Status</th>
        <th>Aktion</th>
      </tr>
    </thead>
    <tbody>
      <% testimonials.forEach(function(t) { %>
      <tr>
        <td>
          <div class="product-thumb" style="<% if (t.image) { %>background-image: url(<%= t.image %>)<% } else { %>background: linear-gradient(135deg, #1a1a2e, #2a1a3e)<% } %>">
            <% if (!t.image) { %><i class="fas fa-user"></i><% } %>
          </div>
        </td>
        <td><strong><%= t.name %></strong></td>
        <td><%= t.text.substring(0, 60) %><%= t.text.length > 60 ? '...' : '' %></td>
        <td><%= t.rating %>/5</td>
        <td><span class="status-badge <%= t.active ? 'status-verfuegbar' : 'status-ausverkauft' %>"><%= t.active ? 'Aktiv' : 'Inaktiv' %></span></td>
        <td>
          <button class="btn btn-sm btn-secondary" onclick='openEdit(<%= JSON.stringify(t) %>)'><i class="fas fa-edit"></i></button>
          <form method="POST" action="/admin/testimonials/loeschen/<%= t.id %>" style="display:inline" onsubmit="return confirm('Wirklich löschen?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
          </form>
        </td>
      </tr>
      <% }); %>
    </tbody>
  </table>
</div>

<div class="modal" id="addModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Neues Testimonial</h3>
      <button class="modal-close" onclick="closeModal('addModal')">&times;</button>
    </div>
    <form method="POST" action="/admin/testimonials" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" required>
        </div>
        <div class="form-group">
          <label>Text *</label>
          <textarea name="text" rows="3" required></textarea>
        </div>
        <div class="form-group">
          <label>Bewertung (1-5)</label>
          <input type="number" name="rating" min="1" max="5" value="5">
        </div>
        <div class="form-group">
          <label>Bild</label>
          <input type="file" name="image" accept="image/*">
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>
</div>

<div class="modal" id="editModal">
  <div class="modal-content">
    <div class="modal-header">
      <h3>Testimonial bearbeiten</h3>
      <button class="modal-close" onclick="closeModal('editModal')">&times;</button>
    </div>
    <form method="POST" enctype="multipart/form-data" id="editForm">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-grid">
        <div class="form-group">
          <label>Name *</label>
          <input type="text" name="name" id="editName" required>
        </div>
        <div class="form-group">
          <label>Text *</label>
          <textarea name="text" rows="3" id="editText" required></textarea>
        </div>
        <div class="form-group">
          <label>Bewertung (1-5)</label>
          <input type="number" name="rating" min="1" max="5" id="editRating">
        </div>
        <div class="form-group">
          <label>Bild</label>
          <input type="file" name="image" accept="image/*">
          <small>Aktuelles Bild: <span id="editImageName" style="color:var(--text-secondary)"></span></small>
        </div>
        <div class="form-group">
          <label><input type="checkbox" name="active" value="1" id="editActive" checked> Aktiv</label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Speichern</button>
    </form>
  </div>
</div>

<script>
function openEdit(t) {
  document.getElementById('editForm').action = '/admin/testimonials/bearbeiten/' + t.id;
  document.getElementById('editName').value = t.name;
  document.getElementById('editText').value = t.text;
  document.getElementById('editRating').value = t.rating;
  document.getElementById('editActive').checked = t.active == 1;
  document.getElementById('editImageName').textContent = t.image || 'Kein Bild';
  openModal('editModal');
}
</script>
<%- include('footer') %>