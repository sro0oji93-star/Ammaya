<%- include('layout') %>
<div class="section-header-row">
  <h2><i class="fas fa-cog"></i> Einstellungen</h2>
</div>

<% if (typeof success !== 'undefined' && success) { %>
<div class="alert alert-success"><i class="fas fa-check-circle"></i> <%= success %></div>
<% } %>

<form method="POST" action="/admin/einstellungen" class="settings-form">
  <div class="settings-card">
    <h3>Allgemein</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Restaurantname</label>
        <input type="text" name="site_name" value="<%= settings.site_name || '' %>">
      </div>
      <div class="form-group">
        <label>Beschreibung</label>
        <input type="text" name="site_description" value="<%= settings.site_description || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Kontaktdaten</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Adresse</label>
        <input type="text" name="address" value="<%= settings.address || '' %>">
      </div>
      <div class="form-group">
        <label>Telefon</label>
        <input type="text" name="phone" value="<%= settings.phone || '' %>">
      </div>
      <div class="form-group">
        <label>E-Mail</label>
        <input type="email" name="email" value="<%= settings.email || '' %>">
      </div>
      <div class="form-group">
        <label>Öffnungszeiten</label>
        <input type="text" name="opening_hours" value="<%= settings.opening_hours || '' %>">
      </div>
      <div class="form-group">
        <label>Breitengrad (Map)</label>
        <input type="text" name="latitude" value="<%= settings.latitude || '' %>">
      </div>
      <div class="form-group">
        <label>Längengrad (Map)</label>
        <input type="text" name="longitude" value="<%= settings.longitude || '' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Lieferung</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Liefergebühr (€)</label>
        <input type="number" step="0.01" name="delivery_fee" value="<%= settings.delivery_fee || '0' %>">
      </div>
      <div class="form-group">
        <label>Kostenfreie Lieferung ab (€)</label>
        <input type="number" step="0.01" name="free_delivery_from" value="<%= settings.free_delivery_from || '0' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Social Media</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Instagram URL</label>
        <input type="url" name="social_instagram" value="<%= settings.social_instagram || '' %>">
      </div>
      <div class="form-group">
        <label>Facebook URL</label>
        <input type="url" name="social_facebook" value="<%= settings.social_facebook || '' %>">
      </div>
      <div class="form-group">
        <label>TikTok URL</label>
        <input type="url" name="social_tiktok" value="<%= settings.social_tiktok || '' %>">
      </div>
    </div>
  </div>


  <div class="settings-card">
    <h3>Startseite</h3>
    <div class="form-group">
      <label>Über uns - Titel</label>
      <input type="text" name="about_title" value="<%= settings.about_title || '' %>">
    </div>
    <div class="form-group">
      <label>Über uns - Text</label>
      <textarea name="about_text" rows="4"><%= settings.about_text || '' %></textarea>
    </div>
  </div>

  <div class="settings-card">
    <h3>Hero Slider</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Zeile 1</label>
        <input type="text" name="hero_title_1" value="<%= settings.hero_title_1 || '1 GROSSE' %>">
      </div>
      <div class="form-group">
        <label>Zeile 2 (PIZZA)</label>
        <input type="text" name="hero_title_2" value="<%= settings.hero_title_2 || 'PIZZA' %>">
      </div>
      <div class="form-group">
        <label>Zeile 3</label>
        <input type="text" name="hero_title_3" value="<%= settings.hero_title_3 || '+ 4 GETRÄNKE' %>">
      </div>
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label>Preis 1 (Zahl)</label>
        <input type="text" name="hero_price_1" value="<%= settings.hero_price_1 || '19' %>">
      </div>
      <div class="form-group">
        <label>Preis 1 (Cent)</label>
        <input type="text" name="hero_price_1_cents" value="<%= settings.hero_price_1_cents || ',99€' %>">
      </div>
      <div class="form-group">
        <label>Preis 1 (Label)</label>
        <input type="text" name="hero_price_1_tag" value="<%= settings.hero_price_1_tag || 'ABHOLUNG' %>">
      </div>
      <div class="form-group">
        <label>Preis 2 (Zahl)</label>
        <input type="text" name="hero_price_2" value="<%= settings.hero_price_2 || '21' %>">
      </div>
      <div class="form-group">
        <label>Preis 2 (Cent)</label>
        <input type="text" name="hero_price_2_cents" value="<%= settings.hero_price_2_cents || ',99€' %>">
      </div>
      <div class="form-group">
        <label>Preis 2 (Label)</label>
        <input type="text" name="hero_price_2_tag" value="<%= settings.hero_price_2_tag || 'LIEFERUNG' %>">
      </div>
    </div>
    <div class="form-group">
      <label>Beschreibungstext</label>
      <input type="text" name="hero_description" value="<%= settings.hero_description || 'Bestellen Sie eine große 3-Belag-Pizza und erhalten Sie 4 Getränke (330ml) gratis!' %>">
    </div>
    <div class="form-group">
      <label>Button-Text</label>
      <input type="text" name="hero_button_text" value="<%= settings.hero_button_text || 'JETZT BESTELLEN' %>">
    </div>
    <div class="form-grid">
      <div class="form-group">
        <label>Hintergrundbild URL</label>
        <input type="text" name="hero_bg_image" value="<%= settings.hero_bg_image || '/images/revolution/6cbea-bg1.jpg' %>">
      </div>
      <div class="form-group">
        <label>Pizza Hauptbild URL</label>
        <input type="text" name="hero_main_image" value="<%= settings.hero_main_image || '/images/revolution/75ec1-big1.png' %>">
      </div>
      <div class="form-group">
        <label>Getränk (oben links) URL</label>
        <input type="text" name="hero_image_drink_tl" value="<%= settings.hero_image_drink_tl || '/images/revolution/f13af-big3.png' %>">
      </div>
      <div class="form-group">
        <label>Getränk (oben rechts) URL</label>
        <input type="text" name="hero_image_drink_tr" value="<%= settings.hero_image_drink_tr || '/images/revolution/d70da-big4.png' %>">
      </div>
      <div class="form-group">
        <label>Getränk (unten rechts) URL</label>
        <input type="text" name="hero_image_drink_br" value="<%= settings.hero_image_drink_br || '/images/revolution/96fdd-big6.png' %>">
      </div>
    </div>
  </div>

  <div class="settings-card">
    <h3>Design</h3>
    <div class="form-grid">
      <div class="form-group">
        <label>Primärfarbe (Buttons, Header)</label>
        <input type="color" name="primary_color" value="<%= settings.primary_color || '#eb0029' %>" style="width:100%;height:40px;padding:2px;cursor:pointer">
      </div>
      <div class="form-group">
        <label>Sekundärfarbe (Hover, Akzente)</label>
        <input type="color" name="secondary_color" value="<%= settings.secondary_color || '#ff4d4d' %>" style="width:100%;height:40px;padding:2px;cursor:pointer">
      </div>
      <div class="form-group">
        <label>Schriftart</label>
        <select name="font_family">
          <option value="Inter" <%= settings.font_family === 'Inter' || !settings.font_family ? 'selected' : '' %>>Inter (Modern)</option>
          <option value="Playfair Display" <%= settings.font_family === 'Playfair Display' ? 'selected' : '' %>>Playfair Display (Elegant)</option>
          <option value="Josefin Sans" <%= settings.font_family === 'Josefin Sans' ? 'selected' : '' %>>Josefin Sans (Rund)</option>
          <option value="Lato" <%= settings.font_family === 'Lato' ? 'selected' : '' %>>Lato (Klassisch)</option>
        </select>
      </div>
      <div class="form-group">
        <label>Logo URL (optional)</label>
        <input type="text" name="logo_url" value="<%= settings.logo_url || '' %>" placeholder="https://example.com/logo.png">
      </div>
    </div>
  </div>

  <button type="submit" class="btn btn-primary btn-lg">Einstellungen speichern</button>
</form>
<%- include('footer') %>
