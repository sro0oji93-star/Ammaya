<% /* NEXO Box-Konfiguration – Locals: productId, boxSlug, boxGroups (von resolveGroups). Radios vorausgewählt, Checkboxen mit Max-Limit. */ %>
<div class="box-choices" data-box-for="<%= productId %>" data-box-slug="<%= boxSlug %>" style="margin-top:10px;border:1px dashed #e5c8ce;border-radius:10px;padding:10px 12px;background:#fffdf7">
  <% boxGroups.forEach(function(g) { %>
    <% if (g.type === 'radio') { %>
    <details class="box-radio-group" data-group="<%= g.key %>" style="margin-top:8px"<%= boxGroups.indexOf(g) === 0 ? ' open' : '' %>>
      <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223"><%= g.label %>: <span class="box-current" style="font-weight:400;color:#9c7c1a;font-size:12px"><%= g.options[0] %></span></summary>
      <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:6px">
        <% g.options.forEach(function(opt, oi) { %>
        <label style="display:flex;align-items:center;gap:8px;cursor:pointer;padding:6px 14px;border:2px solid #3a3a41;border-radius:10px;font-size:13px;background:#fff;color:#232223">
          <input type="radio" name="box_<%= productId %>_<%= g.key %>" value="<%= opt %>" data-box-group="<%= g.key %>" data-box-value="<%= opt %>" style="display:none" <%= oi === 0 ? 'checked' : '' %>>
          <span style="font-weight:600;font-size:13px"><%= opt %></span>
          <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900">✓</span>
        </label>
        <% }); %>
      </div>
    </details>
    <% } else { %>
    <details style="margin-top:8px">
      <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223"><%= g.title %> <span style="font-weight:400;color:#7a7879;font-size:12px">– max. <%= g.max %> wählen</span></summary>
      <div style="margin-top:8px;display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto;padding-right:4px">
        <% g.options.forEach(function(opt) { %>
        <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:8px;border:1.5px solid transparent">
          <input type="checkbox" name="box_<%= productId %>_<%= g.key %>" value="<%= opt %>" data-box-group="<%= g.key %>" data-box-value="<%= opt %>" data-max="<%= g.max %>" style="width:16px;height:16px;accent-color:#16a34a">
          <span style="flex:1;font-weight:600;color:#232223"><%= opt %></span>
          <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900;font-size:14px">✓</span>
        </label>
        <% }); %>
      </div>
    </details>
    <% } %>
  <% }); %>
</div>
<script>(function() {
  var box = document.querySelector('.box-choices[data-box-for="<%= productId %>"]');
  if (!box || box.dataset.summaryInit) return;
  box.dataset.summaryInit = '1';
  box.addEventListener('change', function() {
    box.querySelectorAll('details.box-radio-group').forEach(function(d) {
      var checked = d.querySelector('input[type="radio"]:checked');
      var cur = d.querySelector('.box-current');
      if (cur) cur.textContent = checked ? checked.value : 'bitte wählen';
    });
  });
})();</script>
