<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof settings !== 'undefined' && settings.site_description ? settings.site_description : 'Ammaya Restaurant' %>">
  <meta name="theme-color" content="#b8001f">
  <title><%= typeof title !== 'undefined' ? title : 'Ammaya' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Lato:ital,wght@0,300;0,400;0,700;0,900;1,300;1,400;1,700;1,900&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons%7CMaterial+Icons+Outlined%7CMaterial+Icons+Round%7CMaterial+Icons+Sharp" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="https://cdn.linearicons.com/free/1.0.0/icon-font.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍽️</text></svg>">
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Ammaya' %>">
  <meta property="og:description" content="<%= typeof settings !== 'undefined' && settings.site_description ? settings.site_description : 'Ammaya Restaurant' %>">
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <style>
    .mad-preloader {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      background: #fff; z-index: 99999; display: flex;
      align-items: center; justify-content: center;
      transition: opacity .4s, visibility .4s;
    }
    .mad-preloader.loaded { opacity: 0; visibility: hidden; pointer-events: none; }
  </style>
</head>
<body>
<div class="mad-preloader" id="preloader">
  <span style="font-family:'Josefin Sans',sans-serif;font-size:42px;font-weight:700;color:#b8001f;font-style:italic;">Ammaya</span>
</div>

<!-- Pre-header -->
<div class="pre-header">
  <div class="container">
    <div class="pre-header-inner">
      <div class="pre-header-info">
        <span class="pre-header-item">
          <i class="material-icons-outlined">location_on</i>
          <span><%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Berlin' %></span>
        </span>
        <span class="pre-header-item">
          <i class="material-icons">access_time</i>
          <span><%= typeof settings !== 'undefined' && settings.opening_hours ? settings.opening_hours : 'Mo–So: 11:30 – 22:30' %></span>
        </span>
      </div>
      <div class="pre-header-links">
        <a href="/speisekarte">Speisekarte</a>
        <span class="pre-header-sep">|</span>
        <a href="/kontakt">Kontakt</a>
      </div>
    </div>
  </div>
</div>

<!-- Navbar -->
<nav class="navbar" id="navbar">
  <div class="container">
    <div class="navbar-inner">
      <a href="/" class="nav-logo">
        <span class="nav-logo-icon">A</span>
        <span class="nav-logo-text"><%= typeof settings !== 'undefined' && settings.site_name ? settings.site_name : 'Ammaya' %></span>
      </a>
      <div class="nav-toggle" id="navToggle" aria-label="Menü öffnen">
        <span></span><span></span><span></span>
      </div>
      <div class="nav-menu" id="navMenu">
        <a href="/" class="nav-link"><i class="material-icons">home</i> Start</a>
        <a href="/speisekarte" class="nav-link"><i class="material-icons">restaurant_menu</i> Speisekarte</a>
        <a href="/warenkorb" class="nav-link cart-link">
          <i class="material-icons-outlined">shopping_cart</i> Warenkorb
          <span class="cart-badge" id="cartBadge">0</span>
        </a>
        <a href="/kontakt" class="nav-link"><i class="material-icons">email</i> Kontakt</a>
        <a href="/admin" class="nav-link" style="opacity:.4;font-size:13px"><i class="material-icons">lock</i></a>
      </div>
    </div>
  </div>
</nav>
