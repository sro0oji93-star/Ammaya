
<footer class="footer">
  <div class="footer-decoration">
    <span>✦</span><span>✦</span><span>✦</span>
  </div>
  <div class="footer-container">
    <div class="footer-grid">
      <div class="footer-info">
        <h3 class="footer-logo"><%= typeof settings !== 'undefined' && settings.site_name ? settings.site_name : 'Feinschmeckerei' %></h3>
        <p class="footer-desc">Bei Ammaya vereinen wir internationale Küche mit Leidenschaft. Frisch zubereitet mit den besten Zutaten – für Ihren Genuss.</p>
        <div class="footer-social">
          <a href="<%= typeof settings !== 'undefined' && settings.social_instagram ? settings.social_instagram : '#' %>" target="_blank" rel="noopener" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
          <a href="<%= typeof settings !== 'undefined' && settings.social_facebook ? settings.social_facebook : '#' %>" target="_blank" rel="noopener" class="social-link" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
          <a href="<%= typeof settings !== 'undefined' && settings.social_tiktok ? settings.social_tiktok : '#' %>" target="_blank" rel="noopener" class="social-link" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
        </div>
      </div>
      <div class="footer-links">
        <h4>Navigation</h4>
        <a href="/">Startseite</a>
        <a href="/speisekarte">Speisekarte</a>
        <a href="/warenkorb">Warenkorb</a>
        <a href="/kontakt">Kontakt</a>
      </div>
      <div class="footer-hours">
        <h4>Öffnungszeiten</h4>
        <p><%= typeof settings !== 'undefined' && settings.opening_hours ? settings.opening_hours : 'Mo–So: 11:30 – 22:30' %></p>
        <p class="footer-note">Küche durchgehend warme Küche</p>
      </div>
      <div class="footer-contact">
        <h4>Kontakt</h4>
        <p><i class="fas fa-map-marker-alt"></i> <%= typeof settings !== 'undefined' && settings.address ? settings.address : 'Berlin' %></p>
        <p><i class="fas fa-phone"></i> <a href="tel:<%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '' %>"><%= typeof settings !== 'undefined' && settings.phone ? settings.phone : '' %></a></p>
        <p><i class="fas fa-envelope"></i> <a href="mailto:<%= typeof settings !== 'undefined' && settings.email ? settings.email : '' %>"><%= typeof settings !== 'undefined' && settings.email ? settings.email : '' %></a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>&copy; 2026 <%- typeof settings !== 'undefined' && settings.site_name ? settings.site_name : 'Feinschmeckerei' %>. Alle Rechte vorbehalten. | Mit <span class="footer-heart">❤</span> für Genießer gemacht</p>
    </div>
  </div>
</footer>

<div class="cart-toast" id="cartToast">
  <i class="fas fa-check-circle"></i>
  <span id="cartToastMsg">Zum Warenkorb hinzugefügt!</span>
</div>

<script src="/js/main.js"></script>
<script src="/js/cart.js"></script>
</body>
</html>
