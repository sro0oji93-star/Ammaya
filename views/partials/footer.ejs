<!-- Cart overlay / menu toggle -->
<script>
// Mobile nav toggle
document.addEventListener('DOMContentLoaded', function() {
  // Mobile toggle
  var toggle = document.querySelector('.mad-navigation-container');
  // Close mobile menu on link click
  document.querySelectorAll('.mad-navigation a').forEach(function(link) {
    link.addEventListener('click', function() {
      document.querySelector('.mad-navigation-container').classList.remove('opened');
    });
  });
});
</script>
