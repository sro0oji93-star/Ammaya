<% /* Schoko-Box Dessert – Locals: productId. Genau 2 Pflicht (inklusive). Liste unten pflegen (identisch mit Server-Liste in routes/order.js). */ %>
<div class="box-choices choco-box" data-chocobox-for="<%= productId %>" style="margin-top:10px;border:1px dashed #e5c8ce;border-radius:10px;padding:10px 12px;background:#fffdf7">
  <details>
    <summary style="cursor:pointer;font-weight:700;font-size:13px;color:#232223">Schoko-Auswahl <span style="font-weight:400;color:#7a7879;font-size:12px">– bitte 2 wählen (inklusive)</span></summary>
    <div style="margin-top:8px;display:flex;flex-direction:column;gap:2px;max-height:220px;overflow-y:auto;padding-right:4px">
      <% ['Nutella', 'Weiße Schokolade', 'Pistaziencreme', 'Puderzucker'].forEach(function(nm) { %>
      <label style="display:flex;align-items:center;gap:8px;font-size:13px;cursor:pointer;padding:4px 6px;border-radius:8px;border:1.5px solid transparent">
        <input type="checkbox" data-choco="<%= nm %>" data-max="2" style="width:16px;height:16px;accent-color:#16a34a">
        <span style="flex:1;font-weight:600;color:#232223"><%= nm %></span>
        <span class="sauce-tick" style="display:none;color:#16a34a;font-weight:900;font-size:14px">✓</span>
      </label>
      <% }); %>
    </div>
  </details>
</div>
