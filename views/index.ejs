<%- include('partials/header') %>

<!-- Animated Hero Slider -->
<section class="hero mad-hero-animated" style="position:relative;overflow:hidden;min-height:92vh;display:flex;align-items:center">
  <div class="hero-overlay"></div>

  <% if (heroSlides && heroSlides.length > 0) { %>
  <% heroSlides.forEach(function(slide, idx) { %>
  <div class="hero-slide-items" style="position:absolute;inset:0;z-index:2;background:url('<%= slide.bg_image || '/images/revolution/6cbea-bg1.jpg' %>') center/cover no-repeat;display:<%= idx === 0 ? 'flex' : 'none' %>;align-items:center">
    <div class="hero-inner" style="width:100%;max-width:1400px;margin:0 auto;padding:0 20px">
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:30px">
        <!-- Left: Text -->
        <div class="mad-hero-text" style="flex:1;min-width:320px;max-width:600px;opacity:0;animation:fadeInUp 1s ease-out 0.5s forwards">
          <div class="mad-hero-title"><span class="t1"><%= slide.line1 || '1 GROSSE' %></span><br><span class="t2"><%= slide.line2 || 'PIZZA' %></span><br><span class="t3"><%= slide.line3 || '+ 4 GETRÄNKE' %></span></div>
          <div class="mad-hero-prices">
            <span class="mad-price"><%= slide.price1 || '19' %><span class="cents"><%= slide.price1_cents || ',99€' %></span> <span class="tag"><%= slide.price1_tag || 'ABHOLUNG' %></span></span>
            <span class="mad-price"><%= slide.price2 || '21' %><span class="cents"><%= slide.price2_cents || ',99€' %></span> <span class="tag"><%= slide.price2_tag || 'LIEFERUNG' %></span></span>
          </div>
          <p class="mad-hero-desc"><%= slide.description || '' %></p>
          <a href="<%= slide.button_link || '/speisekarte' %>" class="btn btn-big btn-style-3 mad-order-btn"><%= slide.button_text || 'JETZT BESTELLEN' %></a>
        </div>
        <!-- Right: Pizza + Drinks -->
        <div class="mad-pizza-world" style="flex:1;min-width:350px;max-width:700px;position:relative;min-height:550px">
          <div class="pz-main"><img src="<%= slide.main_image || '/images/revolution/75ec1-big1.png' %>" alt=""></div>
          <% if (slide.drink_tl) { %><div class="pz-drink d-tl"><img src="<%= slide.drink_tl %>" alt=""></div><% } %>
          <% if (slide.drink_tr) { %><div class="pz-drink d-tr"><img src="<%= slide.drink_tr %>" alt=""></div><% } %>
          <% if (slide.drink_br) { %><div class="pz-drink d-br"><img src="<%= slide.drink_br %>" alt=""></div><% } %>
        </div>
      </div>
    </div>
  </div>
  <% }); %>

  <!-- Slider Dots -->
  <% if (heroSlides.length > 1) { %>
  <div class="hero-dots" style="position:absolute;bottom:30px;left:50%;transform:translateX(-50%);display:flex;gap:12px;z-index:10">
    <% heroSlides.forEach(function(s, idx) { %>
    <span class="hero-dot" data-index="<%= idx %>" style="width:14px;height:14px;border-radius:50%;background:<%= idx === 0 ? '#eb0029' : 'rgba(255,255,255,0.5)' %>;cursor:pointer;transition:all .3s;border:2px solid rgba(255,255,255,0.3)"></span>
    <% }); %>
  </div>
  <% } %>
  <% } else { %>
  <!-- Fallback if no slides -->
  <div class="hero-inner" style="width:100%;max-width:1400px;margin:0 auto;padding:0 20px;position:relative;z-index:2">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:30px">
      <div class="mad-hero-text" style="flex:1;min-width:320px;max-width:600px">
        <div class="mad-hero-title"><span class="t1">Willkommen</span></div>
        <a href="/speisekarte" class="btn btn-big btn-style-3 mad-order-btn">ZUR SPEISEKARTE</a>
      </div>
    </div>
  </div>
  <% } %>
</section>

<style>
.hero-overlay { position:absolute;inset:0;background:rgba(0,0,0,.35);z-index:1; }
.hero-slide-items { z-index:2; }
.hero-dot { transition:all .3s; }
.hero-dot:hover { background:#eb0029 !important; }

/* Text */
.mad-hero-text { }
.mad-hero-title { font-family:'Josefin Sans',sans-serif;font-weight:700;font-style:italic;color:#fff;text-shadow:3px 3px 0 #eb0029,5px 5px 0 #eb0029;line-height:1.2; }
.t1 { font-size:clamp(36px,5vw,80px);display:inline-block;opacity:0;animation:slideText 0.7s ease-out 0.6s forwards; }
.t2 { font-size:clamp(50px,7vw,115px);text-decoration:underline;display:inline-block;opacity:0;animation:slideText 0.7s ease-out 0.9s forwards; }
.t3 { font-size:clamp(32px,4.5vw,72px);display:inline-block;opacity:0;animation:slideText 0.7s ease-out 1.2s forwards; }

.mad-hero-prices { margin-top:20px;display:flex;gap:20px;opacity:0;animation:fadeInUp 0.7s ease-out 1.5s forwards; }
.mad-price { font-family:'Josefin Sans',sans-serif;font-size:clamp(36px,5vw,85px);font-weight:700;font-style:italic;color:#ebe117;text-shadow:3px 3px 0 #eb0029,4px 4px 0 #eb0029;line-height:1; }
.cents { font-size:clamp(20px,2.5vw,48px); }
.tag { display:block;font-size:clamp(10px,0.9vw,15px);font-weight:700;color:#ebe117;text-shadow:2px 2px 0 #eb0029,3px 3px 0 #eb0029; }

.mad-hero-desc { margin-top:15px;font-size:16px;color:rgba(255,255,255,.85);max-width:80%;opacity:0;animation:fadeInUp 0.7s ease-out 1.8s forwards; }
.mad-order-btn { margin-top:25px;opacity:0;animation:fadeInUp 0.7s ease-out 2.2s forwards; }

/* Pizza world */
.mad-pizza-world { position:relative;margin:0 auto;width:100%;aspect-ratio:1/1;pointer-events:none; }

.pz-main { position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:0;z-index:6;animation:slidePizza 0.8s ease-out 0.1s forwards,gentleFloat 3.5s ease-in-out infinite 1.5s; }
.pz-main img { width:100%;height:auto;object-fit:contain; }

/* Drinks */
.pz-drink { position:absolute;z-index:10;opacity:0;animation:slidePizza 0.6s ease-out forwards,revFloat 3.5s ease-in-out infinite; }
.pz-drink img { width:100%;height:auto; }
.d-tl { top:0;left:0;width:28%;animation-delay:0.4s,2s; }
.d-tr { top:-2%;right:-2%;width:24%;animation-delay:0.55s,2.3s; }
.d-br { bottom:-2%;right:-2%;width:22%;animation-delay:0.85s,2.9s; }

@keyframes slidePizza {
  0% { transform:translateX(200px) rotate(60deg);opacity:0; }
  100% { transform:translateX(0) rotate(0deg);opacity:1; }
}
@keyframes slideText {
  0% { transform:translateX(-40px);opacity:0; }
  100% { transform:translateX(0);opacity:1; }
}
@keyframes fadeInUp {
  0% { transform:translateY(20px);opacity:0; }
  100% { transform:translateY(0);opacity:1; }
}
@keyframes revFloat {
  0%,100% { transform:rotate(-6deg) translateY(0); }
  50% { transform:rotate(6deg) translateY(-5px); }
}
@keyframes gentleFloat {
  0%,100% { transform:translateY(0); }
  50% { transform:translateY(-8px); }
}

/* Mobile */
@media (max-width:767px) {
  .hero { min-height:100vh !important;height:auto !important;padding:100px 0 60px !important; }
  .hero-inner > div { flex-direction:column !important;align-items:center !important; }
  .mad-hero-text { max-width:100% !important;min-width:auto !important;text-align:center;order:1;padding-top:20px; }
  .t1 { font-size:clamp(28px,8vw,50px) !important; }
  .t2 { font-size:clamp(36px,10vw,65px) !important; }
  .t3 { font-size:clamp(22px,6vw,40px) !important; }
  .mad-hero-prices { justify-content:center;gap:15px; }
  .mad-price { font-size:clamp(28px,7vw,50px) !important; }
  .cents { font-size:clamp(16px,4vw,30px) !important; }
  .tag { font-size:clamp(9px,2.5vw,13px) !important; }
  .mad-hero-desc { max-width:100% !important;text-align:center;font-size:14px; }
  .mad-order-btn { display:inline-block; }
  .mad-pizza-world { max-width:280px !important;min-width:250px !important;width:70% !important;height:260px !important;order:2;margin:10px auto 0 !important; }
  .pz-main img { max-height:240px !important;width:auto !important; }
  .d-tl { width:22% !important;top:2% !important;left:2% !important; }
  .d-tr { width:18% !important;top:0 !important;right:0 !important; }
  .d-br { width:16% !important;bottom:0 !important;right:0 !important; }
  .hero-dots { bottom:15px !important; }
  .hero-dot { width:12px !important;height:12px !important; }
}
</style>

<script>
(function() {
  var slides = document.querySelectorAll('.hero-slide-items');
  var dots = document.querySelectorAll('.hero-dot');
  if (slides.length < 2) return;
  var current = 0;
  var interval;
  function showSlide(i) {
    slides.forEach(function(s, idx) { s.style.display = idx === i ? 'flex' : 'none'; });
    dots.forEach(function(d, idx) { d.style.background = idx === i ? '#eb0029' : 'rgba(255,255,255,0.5)'; });
    current = i;
  }
  dots.forEach(function(d) {
    d.addEventListener('click', function() {
      showSlide(parseInt(this.getAttribute('data-index')));
      clearInterval(interval);
      interval = setInterval(function() { showSlide((current + 1) % slides.length); }, 6000);
    });
  });
  interval = setInterval(function() { showSlide((current + 1) % slides.length); }, 6000);
})();
</script>

<div class="container">

  <!-- Category Icons -->
  <div class="mad-menu-box with-slide-top">
    <% categories.forEach(function(c) { %>
    <div class="mad-col">
      <a href="/speisekarte/kategorie/<%= c.slug %>" class="mad-menu-item">
        <i class="mad-menu-icon">
          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
          <i class="fas <%= icon %>" style="font-size:32px;color:#eb0029"></i>
        </i>
        <h6 class="mad-menu-title"><%= c.name %></h6>
      </a>
    </div>
    <% }); %>
  </div>

</div>

<!-- All Products -->
<div class="mad-section">
  <div class="container">
    <div class="mad-products mad-grid mad-grid--cols-4">
      <% products.forEach(function(p) { %>
      <div class="mad-grid-item">
        <div class="mad-product">
          <figure class="mad-product-image">
            <% if (p.image) { %>
            <a href="/speisekarte/produkt/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<i class=&quot;fas fa-utensils&quot; style=&quot;font-size:48px;color:#ccc&quot;></i>'"></a>
            <% } else { %>
            <a href="/speisekarte/produkt/<%= p.slug %>" style="display:flex;align-items:center;justify-content:center;height:200px;background:#f8f5f0"><i class="fas fa-utensils" style="font-size:48px;color:#ccc"></i></a>
            <% } %>
          </figure>
          <div class="mad-product-description">
            <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a></h4>
            <p><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : '' %></p>
          </div>
          <div class="mad-product-calc">
            <% if (p.sizes) { var sz = JSON.parse(p.sizes); var minP = Math.min.apply(null, sz.map(function(s){return s.price})); %>
            <span class="mad-product-price">ab <%= minP.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1">In den Warenkorb</button>
            <% } else { %>
            <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-2 btn-big">Alle ansehen</a>
    </div>
  </div>
</div>

<!-- Half-Section: Create Your Own -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-half-section">
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/revolution/5b6b6-burger.png') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Ihre eigene<br>Kreation</h2>
            <p>Stellen Sie sich Ihre Lieblingspizza oder Ihren Burger selbst zusammen.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Jetzt kombinieren</a>
        </div>
      </div>
    </div>
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/384x384_img3.jpg') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Angebote &<br>Aktionen</h2>
            <p>Verpassen Sie nicht unsere aktuellen Angebote und Sparmenüs.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Angebote entdecken</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Testimonials -->
<div class="mad-section">
  <div class="container">
    <h2 class="mad-page-title align-center">Das sagen unsere Gäste</h2>
    <div class="mad-testimonials">
      <div class="mad-grid mad-grid--cols-2 owl-carousel" id="testimonialCarousel">
        <% testimonials.forEach(function(t) { %>
        <div class="mad-grid-item">
          <div class="mad-testimonial">
            <div data-estimate="5" class="mad-rating"></div>
            <div class="mad-testimonial-info">
              <blockquote><p>"<%= t.text %>"</p></blockquote>
            </div>
            <div class="mad-author">
              <div class="mad-author-img"><% if (t.image) { %><img src="<%= t.image %>" alt="<%= t.name %>" style="width:48px;height:48px;border-radius:50%;object-fit:cover"><% } else { %><span class="material-icons" style="font-size:36px;color:#eb0029">person</span><% } %></div>
              <div class="mad-author-info">
                <cite><%= t.name %></cite>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- App Download -->
<div class="mad-section mad-col-img mad-section--stretched mad-colorizer--scheme-" style="background:linear-gradient(135deg,rgba(35,34,35,.85),rgba(35,34,35,.7)),url('/images/revolution/6cbea-bg1.jpg') center/cover">
  <div class="container">
    <div class="row">
      <div class="col-lg-5 col-sm-10">
        <h2 style="color:#fff;font-style:italic">Bestellen & Bezahlen<br>in wenigen Minuten</h2>
        <p class="content-element-6" style="color:rgba(255,255,255,.7)">Laden Sie unsere App herunter und bestellen Sie ganz einfach von unterwegs. Verfolgen Sie Ihre Bestellung in Echtzeit.</p>
        <div class="btn-set big-btns">
          <a href="#" class="app-btn"><i class="fab fa-apple"></i> App Store</a>
          <a href="#" class="app-btn"><i class="fab fa-google-play"></i> Google Play</a>
        </div>
      </div>
    </div>
  </div>
</div>

