<%- include('partials/header') %>

<div class="hero" id="hero">
  <div class="hero-bg">
    <img src="https://images.unsplash.com/photo-1504674900247-0877df9cc836?w=1600&q=80" alt="Delicious food">
  </div>
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-badge">HERZLICH WILLKOMMEN</div>
    <h1 class="hero-title"><%= typeof settings !== 'undefined' && settings.hero_title ? settings.hero_title : 'Genuss auf höchstem Niveau' %></h1>
    <p class="hero-subtitle"><%= typeof settings !== 'undefined' && settings.hero_subtitle ? settings.hero_subtitle : 'Entdecken Sie unsere vielfältigen Gerichte' %></p>
    <div class="hero-actions">
      <a href="/speisekarte" class="btn btn-yellow btn-lg">
        <span>Speisekarte entdecken</span>
        <i class="material-icons">arrow_right_alt</i>
      </a>
      <a href="/kontakt" class="btn btn-outline">
        <span>Kontakt</span>
        <i class="material-icons">email</i>
      </a>
    </div>
  </div>
  <div class="hero-scroll">
    <span>Entdecken</span>
    <i class="material-icons">keyboard_arrow_down</i>
  </div>
</div>

<% if (typeof banners !== 'undefined' && banners.length > 0) { %>
<section class="banner-section">
  <div class="banner-slider" id="bannerSlider">
    <% banners.forEach(function(b) { %>
    <div class="banner-slide" style="<%= b.image ? 'background-image: url(' + b.image + ')' : '' %>">
      <div class="banner-content">
        <h3><%= b.title %></h3>
        <% if (b.subtitle) { %><p><%= b.subtitle %></p><% } %>
        <% if (b.link) { %><a href="<%= b.link %>" class="btn btn-primary btn-sm">Mehr erfahren</a><% } %>
      </div>
    </div>
    <% }) %>
  </div>
</section>
<% } %>

<section class="section featured-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">EMPFOHLEN</span>
      <h2 class="section-title">Unsere Spezialitäten</h2>
      <p class="section-desc">Von unserem Küchenteam für Sie zusammengestellt</p>
    </div>
    <div class="featured-grid">
      <% featured.forEach(function(p) { %>
      <div class="menu-card" data-id="<%= p.id %>">
        <div class="menu-card-image">
          <div class="menu-card-img" style="<%= p.image ? 'background-image: url(' + p.image + ');background-size:cover;background-position:center;' : 'background: linear-gradient(135deg, #1a1a2e 0%, #2a1a3e 100%);' %>">
            <% if (!p.image) { %>
            <div class="menu-card-placeholder">
              <i class="fas fa-<%= p.category_id == 6 ? 'wine-glass-alt' : (p.category_id == 5 ? 'ice-cream' : (p.category_id == 4 ? 'leaf' : 'drumstick-bite')) %>"></i>
            </div>
            <% } %>
          </div>
          <% if (p.old_price) { %>
          <span class="menu-card-badge">−<%= Math.round((1 - p.price / p.old_price) * 100) %>%</span>
          <% } %>
          <button class="menu-card-cart add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">
            <i class="material-icons">add</i>
          </button>
        </div>
        <div class="menu-card-body">
          <h3 class="menu-card-title"><%= p.name %></h3>
          <p class="menu-card-desc"><%= p.description %></p>
          <div class="menu-card-footer">
            <div class="menu-card-price">
              <% if (p.old_price) { %>
              <span class="price-old"><%= p.old_price.toFixed(2) %> €</span>
              <% } %>
              <span class="price-current"><%= p.price.toFixed(2) %> €</span>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<section class="section about-section">
  <div class="container">
    <div class="about-grid">
      <div class="about-image">
        <div class="about-image-frame">
          <div class="about-image-content">
            <div class="about-image-icon">✦</div>
            <p>Seit 2020</p>
          </div>
        </div>
        <div class="about-image-deco"></div>
      </div>
      <div class="about-content">
        <span class="section-tag">ÜBER UNS</span>
        <h2 class="section-title"><%= typeof settings !== 'undefined' && settings.about_title ? settings.about_title : 'Unsere Philosophie' %></h2>
        <p class="about-text"><%= typeof settings !== 'undefined' && settings.about_text ? settings.about_text : 'Bei Ammaya vereinen wir internationale Küche mit Leidenschaft. Jedes Gericht wird mit Sorgfalt zubereitet, um Ihnen ein unvergessliches Geschmackserlebnis zu bieten.' %></p>
        <div class="about-stats">
          <div class="about-stat">
            <span class="stat-number" data-target="15">0</span>
            <span class="stat-label">Gerichte</span>
          </div>
          <div class="about-stat">
            <span class="stat-number" data-target="100">0</span>
            <span class="stat-label">% Frische</span>
          </div>
          <div class="about-stat">
            <span class="stat-number" data-target="4.9">0</span>
            <span class="stat-label">Bewertung</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (typeof testimonials !== 'undefined' && testimonials.length > 0) { %>
<section class="section testimonials-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">MEINUNGEN</span>
      <h2 class="section-title">Was unsere Gäste sagen</h2>
    </div>
    <div class="testimonials-grid">
      <% testimonials.forEach(function(t) { %>
      <div class="testimonial-card">
        <div class="testimonial-stars">
          <% for (var i = 0; i < 5; i++) { %>
          <i class="fas fa-star <%= i < t.rating ? 'active' : '' %>"></i>
          <% } %>
        </div>
        <p class="testimonial-text">"<%= t.text %>"</p>
        <div class="testimonial-author">
          <div class="testimonial-avatar"><%= t.name.charAt(0) %></div>
          <span><%= t.name %></span>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section cta-section">
  <div class="container">
    <div class="cta-card">
      <div class="cta-deco">✦</div>
      <h2 class="cta-title">Bereit für ein Geschmackserlebnis?</h2>
      <p class="cta-text">Bestellen Sie jetzt bequem online und genießen Sie unsere Köstlichkeiten zu Hause.</p>
      <a href="/speisekarte" class="btn btn-yellow btn-lg">
        <span>Jetzt bestellen</span>
        <i class="material-icons">arrow_right_alt</i>
      </a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
