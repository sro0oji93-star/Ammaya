<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero" style="background-image:url('/images/revolution/6cbea-bg1.jpg')">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-food-row">
      <div class="hero-food-text">
        <% if (settings.hero_text_title) { %><h2 class="hero-text-title"><%= settings.hero_text_title %></h2><% } %>
        <% if (settings.hero_text_subtitle) { %><p class="hero-text-subtitle"><%= settings.hero_text_subtitle %></p><% } %>
        <div class="hero-food-price">
          <span class="hero-price"><%= settings.hero_price || '12' %>€</span>
          <span class="hero-price-label"><%= settings.hero_price_label || 'Nur heute' %></span>
        </div>
      </div>
      <div class="hero-food-img-wrap">
        <img id="heroFoodImg" src="<%= settings.hero_burger_image || '/images/revolution/5b6b6-burger.png' %>" alt="">
      </div>
    </div>
  </div>
</section>

<div class="container">

  <!-- Category Icons -->
  <div class="mad-menu-box with-slide-top">
    <% categories.forEach(function(c) { %>
    <div class="mad-col">
      <a href="/speisekarte/kategorie/<%= c.slug %>" class="mad-menu-item">
        <i class="mad-menu-icon">
          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
          <i class="fas <%= icon %>" style="font-size:32px;color:#eb0029"></i>
        </i>
        <h6 class="mad-menu-title"><%= c.name %></h6>
      </a>
    </div>
    <% }); %>
  </div>

  <!-- Features / About Section -->
  <div class="mad-section">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="content-element-4">
          <h2>Frisch zubereitet &<br> direkt zu Ihnen nach Hause</h2>
          <p>Bei Ammaya bereiten wir jedes Gericht mit Liebe und den frischesten Zutaten zu. Ob Pizza, Pasta, Burger oder Salat – bei uns finden Sie garantiert Ihr neues Lieblingsgericht. Jetzt online bestellen und bequem liefern lassen.</p>
        </div>
        <div class="mad-icon-boxes item-col-2">
          <div class="mad-col">
            <article class="mad-icon-box">
              <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:36px;color:#eb0029">verified</span></i>
              <div class="mad-icon-box-content">
                <h6 class="mad-icon-box-title">Beste Qualität</h6>
                <p>Nur frische und hochwertige Zutaten aus der Region.</p>
              </div>
            </article>
          </div>
          <div class="mad-col">
            <article class="mad-icon-box">
              <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:36px;color:#eb0029">eco</span></i>
              <div class="mad-icon-box-content">
                <h6 class="mad-icon-box-title">Immer frisch</h6>
                <p>Jedes Gericht wird erst nach Ihrer Bestellung zubereitet.</p>
              </div>
            </article>
          </div>
          <div class="mad-col">
            <article class="mad-icon-box">
              <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:36px;color:#eb0029">restaurant_menu</span></i>
              <div class="mad-icon-box-content">
                <h6 class="mad-icon-box-title">Große Auswahl</h6>
                <p>Vielfältige Gerichte für jeden Geschmack.</p>
              </div>
            </article>
          </div>
          <div class="mad-col">
            <article class="mad-icon-box">
              <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:36px;color:#eb0029">delivery_dining</span></i>
              <div class="mad-icon-box-content">
                <h6 class="mad-icon-box-title">Schnelle Lieferung</h6>
                <p>Heiß und frisch direkt zu Ihnen nach Hause.</p>
              </div>
            </article>
          </div>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="mad-img">
          <img src="/images/688x944_img1.jpg" alt="">
        </div>
      </div>
    </div>
  </div>

</div>

<!-- How It Works (full width, colored) -->
<div class="mad-section mad-section--stretched mad-colorizer--scheme-color-2">
  <div class="container">
    <div class="mad-title-wrap align-center">
      <h2 class="mad-page-title">So funktioniert's</h2>
      <p>In nur drei einfachen Schritten zu Ihrem Lieblingsgericht. <br> Bestellen Sie bequem von zu Hause aus.</p>
    </div>
    <div class="mad-icon-boxes with-arrows style-3 align-center item-col-3">
      <div class="mad-col">
        <article class="mad-icon-box">
          <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:48px;color:#eb0029">restaurant</span></i>
          <div class="mad-icon-box-content">
            <h5 class="mad-icon-box-title">1. Gericht auswählen</h5>
            <p>Stöbern Sie durch unsere Speisekarte und wählen Sie Ihre Favoriten.</p>
          </div>
        </article>
      </div>
      <div class="mad-col">
        <article class="mad-icon-box">
          <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:48px;color:#eb0029">payments</span></i>
          <div class="mad-icon-box-content">
            <h5 class="mad-icon-box-title">2. Bezahlen</h5>
            <p>Zahlen Sie bequem per Karte, PayPal oder bar bei Lieferung.</p>
          </div>
        </article>
      </div>
      <div class="mad-col">
        <article class="mad-icon-box">
          <i class="mad-icon-box-icon"><span class="material-icons-outlined" style="font-size:48px;color:#eb0029">delivery_dining</span></i>
          <div class="mad-icon-box-content">
            <h5 class="mad-icon-box-title">3. Genießen</h5>
            <p>Ihr Essen wird frisch zubereitet und direkt zu Ihnen geliefert.</p>
          </div>
        </article>
      </div>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-3 btn-big">Jetzt bestellen</a>
    </div>
  </div>
</div>

<!-- Tabbed Menu -->
<div class="mad-section">
  <div class="container">
    <h2 class="mad-page-title align-center">Entdecken Sie unsere Gerichte</h2>
    <div class="mad-tabs">
      <div role="tablist" aria-label="Kategorien" class="mad-tabs-nav justify-content-center">
        <% categories.forEach(function(c, i) { %>
        <span<%- i === 0 ? ' class="mad-active"' : '' %>><a id="tab-<%= c.id %>-link" href="#tab-<%= c.id %>" role="tab" aria-selected="<%= i === 0 %>" aria-controls="tab-<%= c.id %>" class="mad-tab-link"><%= c.name %></a></span>
        <% }); %>
      </div>
      <div class="mad-tabs-container">
        <% categories.forEach(function(c, ci) { %>
        <% var catProducts = products.filter(function(p) { return p.category_id === c.id; }); %>
        <div id="tab-<%= c.id %>" tabindex="0" role="tabpanel" aria-labelledby="tab-<%= c.id %>-link" class="mad-tab<%- ci === 0 ? ' mad-active' : '' %>">
          <div class="mad-products mad-grid mad-grid--cols-4">
            <% catProducts.forEach(function(p) { %>
            <div class="mad-grid-item">
              <div class="mad-product">
                <figure class="mad-product-image">
                  <% if (p.image) { %>
                  <a href="/speisekarte/produkt/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a>
                  <% } else { %>
                  <a href="/speisekarte/produkt/<%= p.slug %>" style="display:flex;align-items:center;justify-content:center;height:200px;background:#f8f5f0"><i class="fas fa-utensils" style="font-size:48px;color:#ccc"></i></a>
                  <% } %>
                </figure>
                <div class="mad-product-description">
                  <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a></h4>
                  <p><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : '' %></p>
                </div>
                <div class="mad-product-calc">
                  <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
                  <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
                </div>
              </div>
            </div>
            <% }); %>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-2 btn-big">Alle ansehen</a>
    </div>
  </div>
</div>

<!-- Half-Section: Create Your Own -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-half-section">
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/revolution/5b6b6-burger.png') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Ihre eigene<br>Kreation</h2>
            <p>Stellen Sie sich Ihre Lieblingspizza oder Ihren Burger selbst zusammen.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Jetzt kombinieren</a>
        </div>
      </div>
    </div>
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/384x384_img3.jpg') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Angebote &<br>Aktionen</h2>
            <p>Verpassen Sie nicht unsere aktuellen Angebote und Sparmenüs.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Angebote entdecken</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Testimonials -->
<div class="mad-section">
  <div class="container">
    <h2 class="mad-page-title align-center">Das sagen unsere Gäste</h2>
    <div class="mad-testimonials">
