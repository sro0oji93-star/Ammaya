<%- include('partials/header') %>

<!-- Animated Hero Slider -->
<section class="hero mad-hero-animated" style="position:relative;overflow:hidden;display:flex;align-items:center">
  <div class="hero-overlay" style="position:absolute;inset:0;background:rgba(0,0,0,.35);z-index:1"></div>

  <% if (heroSlides && heroSlides.length > 0) { %>
  <% heroSlides.forEach(function(slide, idx) { %>
  <div class="hero-slide-items" style="width:100%;z-index:2;background:url('<%= slide.bg_image || '/images/revolution/6cbea-bg1.jpg' %>') center/cover no-repeat;display:<%= idx === 0 ? 'flex' : 'none' %>;align-items:center;min-height:92vh" data-slide-idx="<%= idx %>">
    <div class="hero-inner" style="width:100%;max-width:1400px;margin:0 auto;padding:120px 20px 60px">
      <div class="hero-slide-inner" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:30px">
        <div class="mad-hero-text" style="flex:1;min-width:320px;max-width:600px">
          <div class="mad-hero-title" style="font-family:'Josefin Sans',sans-serif;font-weight:700;font-style:italic;color:#fff;text-shadow:3px 3px 0 #eb0029,5px 5px 0 #eb0029;line-height:1.2">
            <% if (slide.line1) { %><span style="font-size:clamp(36px,5vw,80px);display:inline-block"><%= slide.line1 %></span><br><% } %>
            <% if (slide.line2) { %><span style="font-size:clamp(50px,7vw,115px);text-decoration:underline;display:inline-block"><%= slide.line2 %></span><br><% } %>
            <% if (slide.line3) { %><span style="font-size:clamp(32px,4.5vw,72px);display:inline-block"><%= slide.line3 %></span><% } %>
          </div>
          <div style="margin-top:20px;display:flex;gap:20px;flex-wrap:wrap">
            <% if (slide.price1) { %>
            <span style="font-family:'Josefin Sans',sans-serif;font-size:clamp(36px,5vw,85px);font-weight:700;font-style:italic;color:#ebe117;text-shadow:3px 3px 0 #eb0029,4px 4px 0 #eb0029;line-height:1"><%= slide.price1 %><% if (slide.price1_cents) { %><span style="font-size:clamp(20px,2.5vw,48px)"><%= slide.price1_cents %></span><% } %> <span style="display:block;font-size:clamp(10px,0.9vw,15px);font-weight:700;color:#ebe117;text-shadow:2px 2px 0 #eb0029,3px 3px 0 #eb0029"><%= slide.price1_tag || 'ABHOLUNG' %></span></span>
            <% } %>
            <% if (slide.price2) { %>
            <span style="font-family:'Josefin Sans',sans-serif;font-size:clamp(36px,5vw,85px);font-weight:700;font-style:italic;color:#ebe117;text-shadow:3px 3px 0 #eb0029,4px 4px 0 #eb0029;line-height:1"><%= slide.price2 %><% if (slide.price2_cents) { %><span style="font-size:clamp(20px,2.5vw,48px)"><%= slide.price2_cents %></span><% } %> <span style="display:block;font-size:clamp(10px,0.9vw,15px);font-weight:700;color:#ebe117;text-shadow:2px 2px 0 #eb0029,3px 3px 0 #eb0029"><%= slide.price2_tag || 'LIEFERUNG' %></span></span>
            <% } %>
          </div>
          <p style="margin-top:15px;font-size:16px;color:rgba(255,255,255,.85);max-width:80%"><%= slide.description || '' %></p>
          <a href="<%= slide.button_link || '/speisekarte' %>" class="btn btn-big btn-style-3" style="margin-top:25px;display:inline-block"><%= slide.button_text || 'JETZT BESTELLEN' %></a>
        </div>
        <div style="flex:1;min-width:350px;max-width:700px;position:relative;min-height:550px;display:flex;align-items:center;justify-content:center">
          <div style="position:relative;width:100%;height:100%;display:flex;align-items:center;justify-content:center">
            <img src="<%= slide.main_image || '/images/revolution/75ec1-big1.png' %>" alt="" style="max-width:100%;max-height:550px;object-fit:contain;animation:gentleFloat 3.5s ease-in-out infinite">
            <% if (slide.drink_tl) { %><img src="<%= slide.drink_tl %>" alt="" style="position:absolute;top:0;left:0;width:28%;animation:revFloat 3.5s ease-in-out infinite"><% } %>
            <% if (slide.drink_tr) { %><img src="<%= slide.drink_tr %>" alt="" style="position:absolute;top:-2%;right:-2%;width:24%;animation:revFloat 3.5s ease-in-out infinite 0.3s"><% } %>
            <% if (slide.drink_br) { %><img src="<%= slide.drink_br %>" alt="" style="position:absolute;bottom:-2%;right:-2%;width:22%;animation:revFloat 3.5s ease-in-out infinite 0.6s"><% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <% }); } %>
</section>

<style>
@keyframes gentleFloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-8px); } }
@keyframes revFloat { 0%,100% { transform:rotate(-6deg) translateY(0); } 50% { transform:rotate(6deg) translateY(-5px); } }
.hero-slide-items .hero-slide-inner > div > div:first-child { animation:slideInLeft 0.7s ease-out 0.3s both; }
.hero-slide-items .hero-slide-inner > div > div:last-child { animation:slideInRight 0.8s ease-out 0.1s both; }
@keyframes slideInLeft { 0% { transform:translateX(-40px);opacity:0; } 100% { transform:translateX(0);opacity:1; } }
@keyframes slideInRight { 0% { transform:translateX(200px) rotate(60deg);opacity:0; } 100% { transform:translateX(0) rotate(0deg);opacity:1; } }
@media (max-width:767px) {
  .hero-slide-items { min-height:auto !important; }
  .hero-slide-items > .hero-inner > div { flex-direction:column !important; }
  .hero-slide-items .mad-hero-text { max-width:100% !important;min-width:auto !important;text-align:center; }
  .hero-slide-items .mad-hero-text p { max-width:100% !important; }
  .hero-slide-items .mad-hero-title span { font-size:clamp(24px,7vw,42px) !important; }
  .hero-slide-items .mad-hero-title span:nth-child(3) { font-size:clamp(32px,9vw,55px) !important; }
  .hero-slide-items .mad-hero-title br + span { font-size:clamp(20px,5vw,36px) !important; }
  .hero-slide-items div[style*="flex:1;min-width:350px"] { min-width:auto !important;min-height:auto !important;max-width:300px !important; }
  .hero-slide-items img[style*="max-width:100%"] { max-height:300px !important; }
  .hero-slide-items img[style*="position:absolute"] { width:22% !important; }
  .hero-slide-items img[style*="right:-2%"] { width:18% !important; }
  .hero-slide-items img[style*="bottom:-2%"] { width:16% !important; }
}
</style>

<script>
(function() {
  var slides = document.querySelectorAll('.hero-slide-items[data-slide-idx]');
  if (slides.length < 2) return;
  var current = 0;
  var interval;
  function showSlide(i) {
    slides.forEach(function(s, idx) {
      s.style.display = idx === i ? 'flex' : 'none';
    });
    current = i;
  }
  interval = setInterval(function() { showSlide((current + 1) % slides.length); }, 6000);
})();
</script>

<div class="container">

  <!-- Category Icons -->
  <div class="mad-menu-box with-slide-top">
    <% categories.forEach(function(c) { %>
    <div class="mad-col">
      <a href="/speisekarte/kategorie/<%= c.slug %>" class="mad-menu-item">
        <i class="mad-menu-icon">
          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
          <i class="fas <%= icon %>" style="font-size:32px;color:#eb0029"></i>
        </i>
        <h6 class="mad-menu-title"><%= c.name %></h6>
      </a>
    </div>
    <% }); %>
  </div>

</div>

<!-- All Products -->
<div class="mad-section">
  <div class="container">
    <div class="mad-products mad-grid mad-grid--cols-4">
      <% products.forEach(function(p) { %>
      <div class="mad-grid-item">
        <div class="mad-product">
          <figure class="mad-product-image">
            <% if (p.image) { %>
            <a href="/speisekarte/produkt/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>" onerror="this.style.display='none';this.parentElement.innerHTML='<i class=&quot;fas fa-utensils&quot; style=&quot;font-size:48px;color:#ccc&quot;></i>'"></a>
            <% } else { %>
            <a href="/speisekarte/produkt/<%= p.slug %>" style="display:flex;align-items:center;justify-content:center;height:200px;background:#f8f5f0"><i class="fas fa-utensils" style="font-size:48px;color:#ccc"></i></a>
            <% } %>
          </figure>
          <div class="mad-product-description">
            <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a></h4>
            <p><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : '' %></p>
          </div>
          <div class="mad-product-calc">
            <% if (p.sizes) { var sz = JSON.parse(p.sizes); var minP = Math.min.apply(null, sz.map(function(s){return s.price})); %>
            <span class="mad-product-price">ab <%= minP.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-has-sizes="1">In den Warenkorb</button>
            <% } else { %>
            <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-2 btn-big">Alle ansehen</a>
    </div>
  </div>
</div>

<!-- Half-Section: Create Your Own -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-half-section">
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/revolution/5b6b6-burger.png') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Ihre eigene<br>Kreation</h2>
            <p>Stellen Sie sich Ihre Lieblingspizza oder Ihren Burger selbst zusammen.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Jetzt kombinieren</a>
        </div>
      </div>
    </div>
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/384x384_img3.jpg') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Angebote &<br>Aktionen</h2>
            <p>Verpassen Sie nicht unsere aktuellen Angebote und Sparmenüs.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Angebote entdecken</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Testimonials -->
<div class="mad-section">
  <div class="container">
    <h2 class="mad-page-title align-center">Das sagen unsere Gäste</h2>
    <div class="mad-testimonials">
      <div class="mad-grid mad-grid--cols-2 owl-carousel" id="testimonialCarousel">
        <% testimonials.forEach(function(t) { %>
        <div class="mad-grid-item">
          <div class="mad-testimonial">
            <div data-estimate="5" class="mad-rating"></div>
            <div class="mad-testimonial-info">
              <blockquote><p>"<%= t.text %>"</p></blockquote>
            </div>
            <div class="mad-author">
              <div class="mad-author-img"><% if (t.image) { %><img src="<%= t.image %>" alt="<%= t.name %>" style="width:48px;height:48px;border-radius:50%;object-fit:cover"><% } else { %><span class="material-icons" style="font-size:36px;color:#eb0029">person</span><% } %></div>
              <div class="mad-author-info">
                <cite><%= t.name %></cite>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- App Download -->
<div class="mad-section mad-col-img mad-section--stretched mad-colorizer--scheme-" style="background:linear-gradient(135deg,rgba(35,34,35,.85),rgba(35,34,35,.7)),url('/images/revolution/6cbea-bg1.jpg') center/cover">
  <div class="container">
    <div class="row">
      <div class="col-lg-5 col-sm-10">
        <h2 style="color:#fff;font-style:italic">Bestellen & Bezahlen<br>in wenigen Minuten</h2>
        <p class="content-element-6" style="color:rgba(255,255,255,.7)">Laden Sie unsere App herunter und bestellen Sie ganz einfach von unterwegs. Verfolgen Sie Ihre Bestellung in Echtzeit.</p>
        <div class="btn-set big-btns">
          <a href="#" class="app-btn"><i class="fab fa-apple"></i> App Store</a>
          <a href="#" class="app-btn"><i class="fab fa-google-play"></i> Google Play</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Instafeed-style grid -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-instafeed">
    <div class="mad-grid item-col-5 no-gutters">
      <div class="mad-col">
