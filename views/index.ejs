<%- include('partials/header') %>

<!-- Hero Section -->
<section class="hero" style="background-image:url('/images/revolution/6cbea-bg1.jpg')">
  <div class="hero-overlay"></div>
  <div class="hero-content">
    <div class="hero-food-row">
      <div class="hero-food-text">
        <% if (settings.hero_text_title) { %><h2 class="hero-text-title"><%= settings.hero_text_title %></h2><% } %>
        <% if (settings.hero_text_subtitle) { %><p class="hero-text-subtitle"><%= settings.hero_text_subtitle %></p><% } %>
      </div>
      <div class="hero-food-right">
        <div class="hero-food-img-wrap">
          <img id="heroFoodImg" src="<%= settings.hero_burger_image || '/images/revolution/5b6b6-burger.png' %>" alt="">
        </div>
        <div class="hero-food-price">
          <span class="hero-price"><%= settings.hero_price || '12' %>€</span>
          <span class="hero-price-label"><%= settings.hero_price_label || 'Nur heute' %></span>
        </div>
      </div>
    </div>
  </div>
</section>

<div class="container">

  <!-- Category Icons -->
  <div class="mad-menu-box with-slide-top">
    <% categories.forEach(function(c) { %>
    <div class="mad-col">
      <a href="/speisekarte/kategorie/<%= c.slug %>" class="mad-menu-item">
        <i class="mad-menu-icon">
          <% 
            var icons = { pizza:'fa-pizza-slice', burger:'fa-hamburger', croque:'fa-bread-slice', salat:'fa-leaf', pasta:'fa-utensils', schnitzel:'fa-drumstick-bite', snacks:'fa-cookie', getraenke:'fa-wine-glass-alt', 'snack-rolls':'fa-egg-roll', 'saucen-dips':'fa-tint' };
            var icon = icons[c.slug] || 'fa-utensils';
          %>
          <i class="fas <%= icon %>" style="font-size:32px;color:#eb0029"></i>
        </i>
        <h6 class="mad-menu-title"><%= c.name %></h6>
      </a>
    </div>
    <% }); %>
  </div>

</div>

<!-- All Products -->
<div class="mad-section">
  <div class="container">
    <div class="mad-products mad-grid mad-grid--cols-4">
      <% var seen = {}; var uniqueProducts = products.filter(function(p) { var key = p.name + p.price; if (seen[key]) return false; seen[key] = true; return true; }); %>
      <% uniqueProducts.forEach(function(p) { %>
      <div class="mad-grid-item">
        <div class="mad-product">
          <figure class="mad-product-image">
            <% if (p.image) { %>
            <a href="/speisekarte/produkt/<%= p.slug %>"><img src="<%= p.image %>" alt="<%= p.name %>"></a>
            <% } else { %>
            <a href="/speisekarte/produkt/<%= p.slug %>" style="display:flex;align-items:center;justify-content:center;height:200px;background:#f8f5f0"><i class="fas fa-utensils" style="font-size:48px;color:#ccc"></i></a>
            <% } %>
          </figure>
          <div class="mad-product-description">
            <h4 class="mad-product-title"><a href="/speisekarte/produkt/<%= p.slug %>" class="mad-link"><%= p.name %></a></h4>
            <p><%= p.description ? p.description.substring(0, 80) + (p.description.length > 80 ? '...' : '') : '' %></p>
          </div>
          <div class="mad-product-calc">
            <span class="mad-product-price"><%= p.price.toFixed(2) %> €</span>
            <button class="btn btn-style-3 btn-small add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">In den Warenkorb</button>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <div class="align-center">
      <a href="/speisekarte" class="btn btn-style-2 btn-big">Alle ansehen</a>
    </div>
  </div>
</div>

<!-- Half-Section: Create Your Own -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-half-section">
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/revolution/5b6b6-burger.png') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Ihre eigene<br>Kreation</h2>
            <p>Stellen Sie sich Ihre Lieblingspizza oder Ihren Burger selbst zusammen.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Jetzt kombinieren</a>
        </div>
      </div>
    </div>
    <div class="mad-col">
      <div class="mad-half-section-item" style="background:linear-gradient(135deg,rgba(35,34,35,.7),rgba(35,34,35,.4)),url('/images/384x384_img3.jpg') center/cover">
        <div class="mad-half-content">
          <div class="content-element-6">
            <h2 class="mad-page-title">Angebote &<br>Aktionen</h2>
            <p>Verpassen Sie nicht unsere aktuellen Angebote und Sparmenüs.</p>
          </div>
          <a href="/speisekarte" class="btn btn-style-3 btn-big">Angebote entdecken</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Testimonials -->
<div class="mad-section">
  <div class="container">
    <h2 class="mad-page-title align-center">Das sagen unsere Gäste</h2>
    <div class="mad-testimonials">
      <div class="mad-grid mad-grid--cols-2 owl-carousel" id="testimonialCarousel">
        <% testimonials.forEach(function(t) { %>
        <div class="mad-grid-item">
          <div class="mad-testimonial">
            <div data-estimate="5" class="mad-rating"></div>
            <div class="mad-testimonial-info">
              <blockquote><p>"<%= t.text %>"</p></blockquote>
            </div>
            <div class="mad-author">
              <div class="mad-author-img"><%= t.image ? '<img src="' + t.image + '" alt="' + t.name + '" style="width:48px;height:48px;border-radius:50%;object-fit:cover">' : '<span class="material-icons" style="font-size:36px;color:#eb0029">person</span>' %></div>
              <div class="mad-author-info">
                <cite><%= t.name %></cite>
              </div>
            </div>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </div>
</div>

<!-- App Download -->
<div class="mad-section mad-col-img mad-section--stretched mad-colorizer--scheme-" style="background:linear-gradient(135deg,rgba(35,34,35,.85),rgba(35,34,35,.7)),url('/images/revolution/6cbea-bg1.jpg') center/cover">
  <div class="container">
    <div class="row">
      <div class="col-lg-5 col-sm-10">
        <h2 style="color:#fff;font-style:italic">Bestellen & Bezahlen<br>in wenigen Minuten</h2>
        <p class="content-element-6" style="color:rgba(255,255,255,.7)">Laden Sie unsere App herunter und bestellen Sie ganz einfach von unterwegs. Verfolgen Sie Ihre Bestellung in Echtzeit.</p>
        <div class="btn-set big-btns">
          <a href="#" class="app-btn"><i class="fab fa-apple"></i> App Store</a>
          <a href="#" class="app-btn"><i class="fab fa-google-play"></i> Google Play</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Latest News -->
<div class="mad-section mad-section--stretched mad-colorizer--scheme-color-5">
  <div class="container">
    <h2 class="mad-page-title align-center">Neueste Beiträge</h2>
    <div class="mad-entities item-col-3 type-3">
      <div class="mad-col">
        <article class="mad-entity">
          <div class="mad-entity-media">
            <img src="/images/448x288_img1.jpg" alt="">
          </div>
          <div class="mad-entity-body">
            <div class="mad-entity-tags">
              <span>Mai 2026</span>
              <span class="mad-in">Neuigkeiten</span>
            </div>
            <h5 class="mad-entity-title"><a href="#" class="mad-link">Neue Frühlingsgerichte</a></h5>
            <p>Entdecken Sie unsere neuen saisonalen Gerichte mit frischen Zutaten der Saison.</p>
            <a href="#" class="mad-read-more small-size">Mehr erfahren</a>
          </div>
        </article>
      </div>
      <div class="mad-col">
        <article class="mad-entity">
          <div class="mad-entity-media">
            <img src="/images/448x288_img2.jpg" alt="">
          </div>
          <div class="mad-entity-body">
            <div class="mad-entity-tags">
              <span>April 2026</span>
              <span>Angebote</span>
            </div>
            <h5 class="mad-entity-title"><a href="#" class="mad-link">Happy Hour Angebote</a></h5>
            <p>Jeden Montag und Dienstag: 20% Rabatt auf alle Burger und Getränke.</p>
            <a href="#" class="mad-read-more small-size">Mehr erfahren</a>
          </div>
        </article>
      </div>
      <div class="mad-col">
        <article class="mad-entity">
          <div class="mad-entity-media">
            <img src="/images/448x288_img3.jpg" alt="">
          </div>
          <div class="mad-entity-body">
            <div class="mad-entity-tags">
              <span>März 2026</span>
              <span>Events</span>
            </div>
            <h5 class="mad-entity-title"><a href="#" class="mad-link">Pasta-Wochen bei Ammaya</a></h5>
            <p>Genießen Sie unsere hausgemachten Pastagerichte zu besonderen Preisen.</p>
            <a href="#" class="mad-read-more small-size">Mehr erfahren</a>
          </div>
        </article>
      </div>
    </div>
  </div>
</div>

<!-- Instafeed-style grid -->
<div class="mad-section no-pd mad-section--stretched-content-no-px">
  <div class="mad-instafeed">
    <div class="mad-grid item-col-5 no-gutters">
      <div class="mad-col">
        <img src="/images/264x264_img1.jpg" alt="">
      </div>
      <div class="mad-col">
        <img src="/images/264x264_img2.jpg" alt="">
      </div>
      <div class="mad-col">
        <img src="/images/448x288_img3.jpg" alt="" style="width:100%;height:100%;object-fit:cover">
      </div>
      <div class="mad-col">
        <img src="/images/384x384_img4.jpg" alt="" style="width:100%;height:100%;object-fit:cover">
      </div>
      <div class="mad-col">
        <img src="/images/384x384_img5.jpg" alt="" style="width:100%;height:100%;object-fit:cover">
      </div>
    </div>
  </div>
</div>

<script>
(function() {
  var img = document.getElementById('heroFoodImg');
  if (!img) return;
  var images = [
    '<%= settings.hero_burger_image || "/images/revolution/5b6b6-burger.png" %>',
    '<%= settings.hero_pizza_image || "/images/pizza_hero.png" %>'
  ];
  var current = 0;
  setInterval(function() {
    current = (current + 1) % images.length;
    img.style.opacity = '0';
    setTimeout(function() {
      img.src = images[current];
      img.style.opacity = '1';
    }, 400);
  }, 5000);
})();
</script>
<%- include('partials/footer') %>
