<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> – Eigentümer</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@400;500;600;700&family=Lato:wght@300;400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="login-page">
  <div class="login-container">
    <div class="login-card" style="border-top:4px solid #d4af37">
      <div class="login-logo">👑</div>
      <h1><%= setup ? 'Eigentümer einrichten' : 'Eigentümer Login' %></h1>
      <p>Privater Bereich – alle Bestellungen</p>
      <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-error"><i class="fas fa-exclamation-circle"></i> <%= error %></div>
      <% } %>
      <% if (setup) { %>
      <form method="POST" action="/eigentuemer/setup">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="username">Benutzername wählen</label>
          <input type="text" id="username" name="username" required minlength="3" placeholder="z.B. chef">
        </div>
        <div class="form-group">
          <label for="password">Passwort wählen (min. 8 Zeichen)</label>
          <input type="password" id="password" name="password" required minlength="8" placeholder="••••••••">
        </div>
        <div class="form-group">
          <label for="password2">Passwort wiederholen</label>
          <input type="password" id="password2" name="password2" required minlength="8" placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Eigentümer-Konto erstellen</button>
      </form>
      <% } else { %>
      <form method="POST" action="/eigentuemer/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label for="username">Benutzername</label>
          <input type="text" id="username" name="username" required placeholder="Benutzername">
        </div>
        <div class="form-group">
          <label for="password">Passwort</label>
          <input type="password" id="password" name="password" required placeholder="••••••••">
        </div>
        <button type="submit" class="btn btn-primary btn-block">Anmelden</button>
      </form>
      <% } %>
    </div>
  </div>
</body>
</html>
