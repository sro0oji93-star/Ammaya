<%- include('partials/header') %>

<div class="page-hero product-hero">
  <div class="page-hero-overlay"></div>
  <div class="page-hero-content">
    <div class="page-hero-badge"><%= product.category_name %></div>
    <h1 class="page-hero-title"><%= product.name %></h1>
  </div>
</div>

<section class="section product-detail-section">
  <div class="container">
    <div class="product-detail">
      <div class="product-detail-image">
        <div class="product-detail-img" style="background: linear-gradient(135deg, #1a1a2e 0%, #2a1a3e 100%);">
          <div class="product-detail-placeholder">
            <i class="fas fa-utensils"></i>
          </div>
        </div>
        <% if (product.old_price) { %>
        <span class="product-detail-badge">−<%= Math.round((1 - product.price / product.old_price) * 100) %>% SPAREN</span>
        <% } %>
      </div>
      <div class="product-detail-info">
        <span class="section-tag"><%= product.category_name %></span>
        <h2><%= product.name %></h2>
        <div class="product-detail-price">
          <% if (product.old_price) { %>
          <span class="price-old"><%= product.old_price.toFixed(2) %> €</span>
          <% } %>
          <span class="price-current"><%= product.price.toFixed(2) %> €</span>
        </div>
        <p class="product-detail-desc"><%= product.description %></p>
        <% if (product.ingredients) { %>
        <div class="product-detail-ingredients">
          <h4><i class="fas fa-seedling"></i> Zutaten</h4>
          <p><%= product.ingredients %></p>
        </div>
        <% } %>
        <div class="product-detail-actions">
          <div class="quantity-selector">
            <button class="qty-btn" id="qtyMinus">−</button>
            <input type="number" id="qtyInput" value="1" min="1" max="20">
            <button class="qty-btn" id="qtyPlus">+</button>
          </div>
          <button class="btn btn-primary btn-lg add-to-cart" data-id="<%= product.id %>" data-name="<%= product.name %>" data-price="<%= product.price %>">
            <i class="fas fa-shopping-bag"></i> In den Warenkorb
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<% if (related.length > 0) { %>
<section class="section related-section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">ÄHNLICHE GERICHTE</span>
      <h2 class="section-title">Das könnte Ihnen auch gefallen</h2>
    </div>
    <div class="featured-grid">
      <% related.forEach(function(p) { %>
      <div class="menu-card" data-id="<%= p.id %>">
        <div class="menu-card-image">
          <div class="menu-card-img" style="background: linear-gradient(135deg, #1a1a2e 0%, #2a1a3e 100%);">
            <div class="menu-card-placeholder"><i class="fas fa-utensils"></i></div>
          </div>
          <button class="menu-card-cart add-to-cart" data-id="<%= p.id %>" data-name="<%= p.name %>" data-price="<%= p.price %>">
            <i class="fas fa-plus"></i>
          </button>
        </div>
        <div class="menu-card-body">
          <h3 class="menu-card-title"><%= p.name %></h3>
          <div class="menu-card-footer">
            <span class="price-current"><%= p.price.toFixed(2) %> €</span>
            <% if (p.old_price) { %>
            <span class="price-old"><%= p.old_price.toFixed(2) %> €</span>
            <% } %>
          </div>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
</section>
<% } %>

<%- include('partials/footer') %>
